# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (the database in DATABASE_URL's path will be created for you if it doesn't exist yet)
DATABASE_URL=postgresql+asyncpg://postgres:your-postgres-password@localhost:5432/tripunify

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM provider: "openai" or "gemini"
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Places API (leave blank to fall back to OpenStreetMap/Nominatim, no key required)
GOOGLE_PLACES_API_KEY=
